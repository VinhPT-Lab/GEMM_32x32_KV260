# Formal equivalence: PE RTL (rtl_asic/PE.v, P_DATAPATH_RESET=0 as in the flow) vs the
# final gate netlist of the hardened PE (gemm_pe/runs/paper_pe), Yosys of OpenLane 1.0.2.
# Gate cells: functional models read from the sky130_fd_sc_hd TT liberty.
read_verilog -sv ${REPO}/rtl_asic/PE.v
chparam -set P_DATAPATH_RESET 0 ProcessingElement
hierarchy -top ProcessingElement
proc; opt_clean
rename ProcessingElement gold
design -stash gold
read_liberty -ignore_miss_func ${PDK_ROOT}/sky130A/libs.ref/sky130_fd_sc_hd/lib/sky130_fd_sc_hd__tt_025C_1v80.lib
read_verilog ${ECO_DIR}/paper/work/equiv/pe_gl.v
hierarchy -top ProcessingElement
proc; flatten; opt_clean
rename ProcessingElement gate
design -stash gate
design -copy-from gold -as gold gold
design -copy-from gate -as gate gate
async2sync
# miter of the two designs; both start from the all-zero state (reset value of every
# flop; the datapath flops of the RTL have no reset and are zero-initialised here too)
miter -equiv -flatten -make_outputs -ignore_gold_x gold gate miter
hierarchy -top miter
flatten; opt_clean
# k-induction proof that the outputs never differ
sat -verify -tempinduct -prove trigger 0 -set-init-zero -seq 1 -maxsteps 20 -show-ports miter
